FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

WORKDIR /app

RUN addgroup --system --gid 1001 appgroup \
    && adduser --system --uid 1001 --ingroup appgroup appuser

COPY backend/requirements.txt ./requirements.txt
COPY backend/extractor-requirements.txt ./extractor-requirements.txt
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir \
        -r requirements.txt \
        -r extractor-requirements.txt

COPY --chown=appuser:appgroup backend/app ./app
COPY --chown=appuser:appgroup backend/extractor ./extractor

USER appuser

ENTRYPOINT ["python", "-m", "app.jobs.scheduled_content_extractor"]
