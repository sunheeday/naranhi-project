NEXT_PUBLIC_APP_NAME=Naranhi

# UI-only preview mode. Use locally when Supabase Auth is not configured yet.
NEXT_PUBLIC_UI_PREVIEW=false

# Supabase client-side configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FastAPI service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SUPABASE_URL=https://your-project-ref.supabase.co
CORS_ORIGINS=http://localhost:3000

# External integrations used by the FastAPI pipeline
OPENAI_API_KEY=your-openai-api-key
GEMINI_API_KEY=your-gemini-api-key
NEIS_API_KEY=your-neis-api-key
GOOGLE_CALENDAR_CREDENTIALS_JSON={}

# School crawler settings
CRAWLER_TIMEOUT_SECONDS=30
CRAWLER_SCHOOL_TIMEOUT_SECONDS=180
CRAWLER_MAX_POSTS=5
CRAWLER_INITIAL_NOTICE_COUNT=5
CRAWLER_NOTICE_CACHE_LIMIT_PER_SCHOOL=50
CRAWLER_SCHEDULE_CONCURRENCY=1
CRAWLER_SCHEDULE_NOTICE_COUNT=10
CRAWLER_UNSUPPORTED_RECHECK_HOURS=168
CRAWLER_SCHEDULE_FAIL_RATE_THRESHOLD=0.5
# Local default should stay false to avoid unexpected Gemini cost.
# In production, set true if rule-based board discovery is not accurate enough.
CRAWLER_ENABLE_GEMINI=false
CRAWLER_INTERNAL_TOKEN=change-this-before-deploy
CRAWLER_TLS_LEGACY_HOSTS=sen.ms.kr,gen.ms.kr

# Content extractor job settings
# For Docker-based local testing, prefer copying .env.extractor.example to
# .env.extractor.local so Next.js/OAuth/multiline values are not passed to Docker.
EXTRACTOR_MAX_NOTICES_PER_RUN=20
EXTRACTOR_NOTICE_TIMEOUT_SECONDS=600
EXTRACTOR_STALE_MINUTES=180
EXTRACTOR_MAX_GEMINI_CALLS_PER_RUN=80
EXTRACTOR_ENABLE_GEMINI_SUMMARY=true
GEMINI_SUMMARY_MODEL=gemini-2.5-flash-lite
EXTRACTOR_SUMMARY_INPUT_CHARS=50000
ENABLE_GEMINI_STRUCTURING=false
MAX_GEMINI_CALLS_PER_NOTICE=8
MAX_INLINE_IMAGES_PER_NOTICE=6
MAX_TOTAL_OCR_BYTES_PER_NOTICE=26214400
MAX_PDF_PAGES_FOR_OCR=20
MAX_FILE_SIZE_MB=50
OCR_INLINE_IMAGES=auto
MAX_IMAGE_PIXELS=50000000
MAX_HWPX_UNCOMPRESSED_BYTES=104857600
MAX_HWPX_ENTRY_BYTES=52428800
MAX_HWPX_COMPRESSION_RATIO=100
TLS_VERIFY_INSECURE_HOSTS=sen.ms.kr,gen.ms.kr
