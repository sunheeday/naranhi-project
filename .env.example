NEXT_PUBLIC_APP_NAME=Naranhi

# UI-only preview mode. Use locally when Supabase Auth is not configured yet.
NEXT_PUBLIC_UI_PREVIEW=false

# Supabase client-side configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Supabase key. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# FastAPI service
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
SUPABASE_URL=https://your-project-ref.supabase.co
CORS_ORIGINS=http://localhost:3000

# External integrations used by the FastAPI pipeline
OPENAI_API_KEY=your-openai-api-key
NEIS_API_KEY=your-neis-api-key
GOOGLE_CALENDAR_CREDENTIALS_JSON={}
